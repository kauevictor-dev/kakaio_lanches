rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TROQUE pelo e-mail do dono (o mesmo que você criar em Authentication > Users)
    function adm() { return request.auth != null && request.auth.token.email == 'SEU_EMAIL@gmail.com'; }

    match /produtos/{id}  { allow read: if true; allow write: if adm(); }
    match /pedidos/{id}   { allow create: if request.resource.data.total is number; allow read, update, delete: if adm(); }
    match /despesas/{id}  { allow read, write: if adm(); }
  }
}
